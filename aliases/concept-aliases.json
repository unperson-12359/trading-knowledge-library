      "parameter": {
        "name": "periods",
        "type": "integer",
        "minimum": 2,
        "maximum": 64
      },
      "legacy_concept_id_template": "parameterized-analytics/{periods}-period-simple-return",
      "legacy_skill_name_template": "tkl-{periods}-period-simple-return",
      "legacy_display_name_template": "{periods}-period simple return",
      "legacy_term_templates": [
        "{periods}-period return",
        "{periods}-period holding period return",
        "{periods}-period price return"
      ],
      "canonical_concept_id": "parameterized-analytics/n-period-simple-return",
      "canonical_skill_name": "tkl-n-period-simple-return"
    }
  ]
}
