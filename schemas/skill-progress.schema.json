{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unperson-12359.github.io/trading-knowledge-library/schemas/skill-progress.schema.json",
  "title": "Concept skill rollout progress",
  "type": "object",
  "required": ["$schema", "schema_version", "target_count", "batch_size", "total_batches", "order", "completed_count", "completed_batches", "next_batch", "batches"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": 1},
    "target_count": {"const": 1500},
    "batch_size": {"const": 20},
    "total_batches": {"const": 75},
    "order": {"const": "core-first-then-master-index"},
    "completed_count": {"type": "integer", "minimum": 0, "maximum": 1500},
    "completed_batches": {"type": "integer", "minimum": 0, "maximum": 75},
    "next_batch": {"type": ["integer", "null"], "minimum": 1, "maximum": 75},
    "batches": {"type": "array", "items": {"type": "object"}}
  },
  "additionalProperties": false
}
