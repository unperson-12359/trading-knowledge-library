{
  "$schema": "https://unperson-12359.github.io/trading-knowledge-library/schemas/source-policy.schema.json",
  "schema_version": 1,
  "tiers": [
    {
      "id": "primary",
      "description": "Regulators, exchanges, clearing venues, protocol specifications, original technical documentation, and original research."
    },
    {
      "id": "canonical-technical",
      "description": "Canonical implementation, standards, or professional technical documentation when a direct primary source is not available."
    },
    {
      "id": "secondary",
      "description": "Recognized educational or explanatory material used for orientation only."
    }
  ],
  "host_tiers": {
    "www.cftc.gov": "primary",
    "www.sec.gov": "primary",
    "www.finra.org": "primary",
    "www.investor.gov": "primary",
    "www.cmegroup.com": "primary",
    "www.cboe.com": "primary",
    "www.bis.org": "primary",
    "www.ecfr.gov": "primary",
    "hyperliquid.gitbook.io": "primary",
    "docs.chain.link": "primary",
    "ethereum.org": "primary",
    "aave.com": "primary",
    "support.uniswap.org": "primary",
    "www.binance.com": "primary",
    "www.bybit.com": "primary",
    "academy.binance.com": "canonical-technical",
    "ta-lib.github.io": "canonical-technical",
    "www.statsmodels.org": "canonical-technical",
    "scikit-learn.org": "canonical-technical",
    "www.nber.org": "canonical-technical",
    "arxiv.org": "canonical-technical",
    "www.aqr.com": "canonical-technical",
    "www.cfainstitute.org": "canonical-technical",
    "rpc.cfainstitute.org": "canonical-technical",
    "www.tradingview.com": "canonical-technical",
    "www.tradingblox.com": "canonical-technical",
    "papers.ssrn.com": "canonical-technical",
    "gitbook-docs.coinmetrics.io": "canonical-technical"
  },
  "default_tier": "secondary"
}
