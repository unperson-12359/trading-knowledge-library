{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unperson-12359.github.io/trading-knowledge-library/schemas/skill-manifest.schema.json",
  "title": "Concept skill catalog manifest",
  "type": "object",
  "required": ["$schema", "schema_version", "concept_count", "skill_count", "alias_count", "skills"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": 2},
    "concept_count": {"type": "integer", "minimum": 1},
    "skill_count": {"type": "integer", "minimum": 1},
    "alias_count": {"type": "integer", "minimum": 0},
    "skills": {"type": "array", "items": {"$ref": "concept-skill.schema.json"}}
  },
  "additionalProperties": false
}
