{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unperson-12359.github.io/trading-knowledge-library/schemas/skill-alias-catalog.schema.json",
  "title": "Expanded concept and skill compatibility aliases",
  "type": "object",
  "required": ["$schema", "schema_version", "alias_count", "aliases"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": 1},
    "alias_count": {"type": "integer", "minimum": 0},
    "aliases": {
      "type": "array",
      "items": {"$ref": "skill-alias.schema.json"}
    }
  },
  "additionalProperties": false
}
