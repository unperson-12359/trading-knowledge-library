    "decision": {"type": "string"},
    "rationale": {"type": "array", "minItems": 3, "items": {"type": "string"}},
    "organization": {"type": "object"},
    "behavior": {"type": "object"},
    "catalog": {"type": "object"},
    "sources": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "warning": {"type": "string"}
  },
  "additionalProperties": false
}
